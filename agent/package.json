{
  "name": "ai-helper-agent",
  "version": "1.15.2",
  "description": "AI Helper Agent - Local file access and system command execution proxy for Chrome extension / AI Helper 代理服务，为 Chrome 扩展提供本地文件读写和系统命令执行",
  "type": "module",
  "main": "./src/server.js",
  "bin": {
    "ai-helper-agent": "bin/agent.js",
    "aha": "bin/agent.js"
  },
  "files": [
    "bin/",
    "src/",
    "dist/",
    "README.md",
    "README.zh-CN.md"
  ],
  "scripts": {
    "start": "node bin/agent.js start",
    "stop": "node bin/agent.js stop",
    "status": "node bin/agent.js status",
    "release": "bash publish.sh",
    "prepublishOnly": "cp -r ../dist ./dist",
    "postpublish": "rm -rf ./dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "archiver": "^8.0.0",
    "ws": "^8.18.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "ai-helper",
    "local-agent",
    "chrome-extension",
    "file-manager",
    "command-executor",
    "developer-tools"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiweicheng/ai-helper.git",
    "directory": "agent"
  },
  "homepage": "https://github.com/xiweicheng/ai-helper/tree/main/agent#readme",
  "bugs": {
    "url": "https://github.com/xiweicheng/ai-helper/issues"
  }
}
