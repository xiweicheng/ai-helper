{
  "name": "ai-helper",
  "version": "2.4.4",
  "description": "AI Helper Chrome Extension",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/fix-build.js",
    "build:silent": "node scripts/silent-build.js",
    "build:docsite": "node scripts/build-docsite.mjs",
    "preview:docsite": "node scripts/build-docsite.mjs --preview",
    "package": "node scripts/package.js",
    "release:agent": "bash agent/publish.sh",
    "push:all": "bash scripts/push-all.sh",
    "sync:wiki": "bash scripts/sync-wiki-to-gitee.sh",
    "preview": "vite",
    "lint": "eslint src/ agent/",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "theme:check": "python3 scripts/theme-migrate.py --check src/side_panel/styles.css src/options/styles.css",
    "theme:contrast": "python3 scripts/theme-contrast-check.py src/shared/theme.css",
    "theme:audit": "node scripts/theme-dark-audit.mjs"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.1.0",
    "@crxjs/vite-plugin": "^2.7.0",
    "@playwright/test": "^1.62.1",
    "acorn": "^8.19.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "jsdom": "^29.1.1",
    "mermaid": "^12.2.0",
    "pagefind": "^1.5.2",
    "sharp": "^0.35.2",
    "vite": "^8.0.0",
    "vite-plugin-static-copy": "^4.1.1",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@jvmr/pptx-to-html": "^1.1.1",
    "docx": "^9.7.1",
    "dompurify": "^3.4.12",
    "jszip": "^3.10.2",
    "mammoth": "^1.6.0",
    "pdfjs-dist": "^3.11.174",
    "xlsx": "^0.18.5"
  }
}
