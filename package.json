{
  "name": "ai-helper",
  "version": "1.0.0",
  "description": "AI Helper Chrome Extension",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/fix-build.js",
    "build:silent": "node scripts/silent-build.js",
    "preview": "vite",
    "lint": "eslint src/",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.1.0",
    "@crxjs/vite-plugin": "^2.7.0",
    "@playwright/test": "^1.62.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.2",
    "vite": "^8.0.0",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@jvmr/pptx-to-html": "^1.1.1",
    "docx": "^9.7.1",
    "dompurify": "^3.4.12",
    "mammoth": "^1.6.0",
    "pdfjs-dist": "^3.11.174",
    "xlsx": "^0.18.5"
  }
}
