{
  "manifest_version": 3,
  "default_locale": "zh",
  "name": "__MSG_extName__",
  "version": "1.0.0",
  "description": "__MSG_extDescription__",
  "permissions": [
    "activeTab",
    "storage",
    "unlimitedStorage",
    "sidePanel",
    "scripting",
    "bookmarks",
    "history",
    "downloads",
    "notifications",
    "tabs",
    "cookies",
    "offscreen",
    "clipboardRead",
    "clipboardWrite",
    "commands"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://*/*",
    "https://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["libs/qrcode.min.js", "libs/marked.min.js", "src/content/index.js"],
      "css": ["styles/styles.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "src/background/index.js"
  },
  "options_page": "options.html",
  "side_panel": {
    "default_path": "side_panel.html"
  },
  "commands": {
    "_toggle_sidepanel": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "__MSG_commandToggleSidepanel__"
    }
  },
  "action": {
    "default_title": "AI Helper",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}